# Painel do Supabase > Project Settings > API Keys
# (aba "Publishable and secret API keys" — não a aba "Legacy")

# Precisa do prefixo NEXT_PUBLIC_ para o client (browser) acessar.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Sem prefixo NEXT_PUBLIC_ — usadas SOMENTE server-side.
# SUPABASE_URL pode repetir o mesmo valor de NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://SEU_PROJETO.supabase.co/auth/v1/.well-known/jwks.json
